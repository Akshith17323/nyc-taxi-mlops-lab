        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "14.4",
          "legendFormat": "Fast burn alert threshold (14.4x)"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "6.0",
          "legendFormat": "Slow burn alert threshold (6x)"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "/predict Latency SLI (1h rolling <= 200ms vs 95% objective)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 57,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.8,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "lab:predict_latency:ratio_rate1h",
          "legendFormat": "Latency SLI (<= 200ms)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "0.95",
          "legendFormat": "Objective (95.0%)"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "/predict Latency Burn Rate (1h & 5m)",
      "datasource": {
