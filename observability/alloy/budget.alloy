// Your series budget (S5, decision 014). Every series from this host passes through one of these three
// before it's sent. Grafana Cloud's free tier allows 10,000 active series for all hosts together
// (contracts/metrics.yaml). With no rules, everything is sent.
//
// Rules are Prometheus relabelling (https://grafana.com/docs/alloy/latest/reference/components/prometheus/prometheus.relabel/):
//   rule { source_labels = ["__name__"]  regex = "node_(cpu|memory)_.*"  action = "keep" }
//   rule { regex = "id"  action = "labeldrop" }

declare "host" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		// The host: CPU, memory, root disk, network and load. Everything else node_exporter offers (NFS,
		// interface flags, per-collector timings, ...) is dropped: ~1,700 series down to ~60.
		rule {
			source_labels = ["__name__"]
			regex         = "node_(cpu_seconds_total|memory_(MemAvailable|MemTotal)_bytes|load(1|5|15)|filesystem_(avail|size)_bytes|network_(receive|transmit)_bytes_total|disk_io_time_seconds_total|boot_time_seconds)"
			action        = "keep"
		}

		rule {
			source_labels = ["__name__", "mountpoint"]
			regex         = "node_filesystem_.*;[^/].*|node_filesystem_.*;/.+"
			action        = "drop"
		}

		rule {
			source_labels = ["__name__", "device"]
			regex         = "node_network_.*;(lo|veth.*|br-.*|docker.*)"
			action        = "drop"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}

declare "containers" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		// Containers: four signals per named container. cAdvisor also reports every cgroup on the host
		// (no `name`), and its `id` and `image` labels change on every deploy, which would mint a new
		// series per container per deploy: drop them, keep `name` (Compose names are stable).
		rule {
			source_labels = ["name"]
			regex         = ""
			action        = "drop"
		}

		rule {
			source_labels = ["__name__"]
			regex         = "container_(cpu_usage_seconds_total|memory_working_set_bytes|network_(receive|transmit)_bytes_total|last_seen)"
			action        = "keep"
		}

		rule {
			regex  = "id|image"
			action = "labeldrop"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}

declare "services" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		// The lab's services: everything in contracts/metrics.yaml, and Traefik's per-service and
		// per-entrypoint request metrics. The Python and Go runtime metrics are dropped.
		rule {
			source_labels = ["__name__"]
			regex         = "(python|process|go|promhttp)_.*|traefik_(config|tls|open_connections|router)_.*"
			action        = "drop"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}
